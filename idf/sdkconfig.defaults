# ---- 目标芯片与 Flash ----
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- OTA：新固件启动后不确认就自动回滚（app 里 45 秒后调 mark_app_valid） ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- 控制台：SuperMini 使用芯片内置 USB-Serial/JTAG ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- RTOS / 主任务 ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

# ---- HTTP 服务器 ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- TLS / HTTPS 客户端 ----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# ---- 看门狗（AT 长命令期间任务不喂狗，放宽到 30s）----
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# ---- 内存优化（C3 只有 ~300KB RAM，TLS 握手需要空间）----
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# 入站记录缓冲：服务器常把整条证书链塞进一个 TLS 记录里，
# smtp.qq.com 那条记录是 5489 字节（DigiCert RSA4096 三级链），4096 装不下，
# 握手直接失败（日志里是 tls=0x87）。8192 能覆盖绝大多数站点。
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# WiFi 收发缓冲：默认 16 个动态 RX + 16 个动态 TX，光这一项就占 40 KB 以上堆。
# 本机只做"收一条短信、发几条 HTTP"，8 个足够，省下来的堆留给 TLS 握手。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8

# ---- 调试期：关闭数字掉电检测 ----
# 4G 模组发射瞬间拉低电源会让 BOD 反复复位（串口打印 Brownout detector was triggered），
# 调试时先关掉。模拟 BOD 由 bootloader 打开、无法关闭，真正的深压降仍会静默复位。
# 发布固件前请删掉这一行，否则写 flash 期间掉压有损坏风险。
CONFIG_ESP_BROWNOUT_DET=n
